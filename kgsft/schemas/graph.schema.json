{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/kgsft/graph.schema.json",
  "title": "KG-SFT Directed Graph Bundle",
  "type": "object",
  "required": ["graph_id", "nodes", "relations"],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "revision": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type", "label", "source_refs"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "node_type": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "relation_id",
        "source_node_id",
        "target_node_id",
        "relation_type",
        "directed",
        "source_refs"
      ],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "source_node_id": {"type": "string", "minLength": 1},
        "target_node_id": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "directed": {"const": true},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
